# ======================================
# Application Settings
# ======================================

# Environment: dev | test | prod
ENV=dev

# Process role: api | scheduler | all
# Default depends on ENV:
#   ENV=dev  -> all (single process for dev convenience; scheduler runs alongside API)
#   ENV=test -> api (scheduler disabled, safer for tests)
#   ENV=prod -> api (must run scheduler as a separate container, see hohu deploy)
# Override only when you need non-default behavior.
# Do NOT set "all" with multiple uvicorn workers — each worker would run its own scheduler.
# APP_ROLE=all

# Generate with: openssl rand -hex 32
SECRET_KEY=<YOUR_SUPER_SECRET_KEY_HERE>  # ⚠️ MUST CHANGE IN PRODUCTION!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================================
# Database (PostgreSQL + asyncpg)
# ======================================
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5432/hohu_admin
# Print SQL statements to console (default: false, set true for debugging)
# DB_ECHO=true

# ======================================
# Redis (for caching, sessions, etc.)
# ======================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password
REDIS_DB=0

# ======================================
# Snowflake ID Generator (for distributed unique IDs)
# ======================================
# Each instance must have a unique worker_id (1-1023)
# Default is 1. Change this when deploying multiple instances.
WORKER_ID=1

# ======================================
# File Upload
# ======================================
# File access base URL
SERVER_URL=http://127.0.0.1:8000

UPLOAD_DIR=uploads
# Must stay outside UPLOAD_DIR. Reverse proxies must also deny the legacy
# /uploads/file_storage/** and legacy .csv/.txt/.xls/.xlsx during upgrade.
PRIVATE_UPLOAD_DIR=private_uploads
LOCAL_FILE_STORAGE_ROOT=private_uploads/file_storage
# UPLOAD_MAX_SIZE=10485760
# UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.zip,.rar,.txt,.csv

# ======================================
# AI Provider Egress
# ======================================
# Official OpenAI/Anthropic/DeepSeek origins are built in. Add custom Provider
# origins here as exact scheme://host:port values; API payloads cannot extend it.
# AI_PROVIDER_EGRESS_ALLOWED_ORIGINS=https://models.example.com:443
# Private/local models require both an exact origin and an explicit CIDR.
# AI_PROVIDER_EGRESS_ALLOWED_CIDRS=10.20.30.40/32
# AI_PROVIDER_EGRESS_PROXY=
# AI_PROVIDER_EGRESS_CONNECT_TIMEOUT_SEC=5
# AI_PROVIDER_EGRESS_READ_TIMEOUT_SEC=30
# AI_PROVIDER_EGRESS_TOTAL_TIMEOUT_SEC=60
# AI_PROVIDER_EGRESS_MAX_RESPONSE_BYTES=2097152
# AI_PROVIDER_EGRESS_MAX_CONCURRENCY=20
# AI_PROVIDER_EGRESS_MAX_RETRIES=1
