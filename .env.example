# ======================================
# Application Settings
# ======================================

# Environment: dev | test | prod
ENV=dev

# Generate with: openssl rand -hex 32
SECRET_KEY=<YOUR_SUPER_SECRET_KEY_HERE>  # ⚠️ MUST CHANGE IN PRODUCTION!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ======================================
# Database (PostgreSQL + asyncpg)
# ======================================
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql+asyncpg://myuser:mypassword@localhost:5432/hohu_admin

# ======================================
# Redis (for caching, sessions, etc.)
# ======================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=  # Leave empty if no password
REDIS_DB=0

# ======================================
# Snowflake ID Generator (for distributed unique IDs)
# ======================================
# Each instance must have a unique worker_id (1-1023)
# Default is 1. Change this when deploying multiple instances.
WORKER_ID=1

# ======================================
# File Upload
# ======================================
# File access base URL
SERVER_URL=http://127.0.0.1:8000

UPLOAD_DIR=uploads
# UPLOAD_MAX_SIZE=10485760
# UPLOAD_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.zip,.rar,.txt,.csv
